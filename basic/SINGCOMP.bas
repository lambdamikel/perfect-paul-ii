10  REM PERFECT PAUL ][ SINGING COMPETITION
20  REM AFTER THE DECTALK DTC01 DEMO ON THE
30  REM TALKER/80 VCF WEST 2025 DISK
50  REM ---- PACING ----
60  REM MS IS HOW LONG THE UTTERANCE TAKES.
70  REM 900 LOOPS = 1 SECOND, SO MS * .9 IS
80  REM REAL TIME. SENDING ALREADY COSTS
90  REM LEN * SD, SO THAT IS SUBTRACTED.
100  REM CH IS MS PER SPOKEN CHARACTER.
110 PF = .9: REM PACING FACTOR
120 SD = 3: REM LOOPS PER CHAR TO SEND
130 CH = 60: REM MS PER SPOKEN CHARACTER
140 SG = 4000: REM MS FOR ONE SUNG SCALE
150 DR =  - 16192: REM SLOT 4  ($C0C0)
160  HOME 
170  PRINT "PERFECT PAUL ]["
180  PRINT "SINGING COMPETITION": PRINT 
190 M$ = "[:PHONE ARPA SPEAK ON]"
200 SC$ = M$ + "[D<100,13>OW<400> R<100,15>EY<400> M<100,17>IY<400> F<100,18>AH<400> S<100,20>OW<400> L<100,22>AH<400> T<100,24>IY<400> D<100,25>OW<400>]"
210  PRINT "  SINGER 1 OF 9: PAUL"
220  READ S$:MS =  LEN (S$) * CH: GOSUB 900
230 S$ = SC$:MS = SG: GOSUB 900
240  FOR L = 2 TO 9
250  READ V$,N$
260  PRINT "  SINGER ";L;" OF 9: ";N$
270 S$ = V$ + " " + N$ + ".":MS =  LEN (S$) * CH: GOSUB 900
280 S$ = SC$:MS = SG: GOSUB 900
290  NEXT L
300  PRINT : PRINT "  THE VERDICT..."
310  FOR L = 1 TO 5
320  READ S$:MS =  LEN (S$) * CH: GOSUB 900
330  NEXT L
340  PRINT : PRINT "DONE."
350  END 
900  REM ---- SEND S$, THEN WAIT OUT THE
910  REM      MS IT WILL TAKE TO SPEAK,
920  REM      LESS THE TIME SPENT SENDING
930  FOR I = 1 TO  LEN (S$): POKE DR, ASC ( MID$ (S$,I,1)): NEXT I
940  POKE DR,13
950 WT = MS * .9 * PF -  LEN (S$) * SD
960  IF WT > 0 THEN  FOR W = 1 TO WT: NEXT W
970  RETURN 
