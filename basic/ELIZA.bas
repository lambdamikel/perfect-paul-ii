10 REM PERFECT PAUL ][ - ELIZA
20 REM AFTER WEIZENBAUM 1966
30 DR = -16192: REM SLOT 4  ($C0C0)
40 DIM KW$(21),RS$(54),RP(21),RN(21),RC(21),GE$(6)
50 NK = 0: NR = 0: GC = 0
60 READ A$: IF A$ = "END" THEN 100
70 NK = NK+1: KW$(NK) = A$: READ NC: RP(NK) = NR+1: RN(NK) = NC: RC(NK) = 0
80 FOR J = 1 TO NC: NR = NR+1: READ RS$(NR): NEXT J
90 GOTO 60
100 READ NG: FOR J = 1 TO NG: READ GE$(J): NEXT J
110 HOME : PRINT "PERFECT PAUL ][ - ELIZA": PRINT
120 SP$ = "HELLO. I AM PAUL. PLEASE TELL ME YOUR PROBLEM.": PRINT SP$: GOSUB 950
200 PRINT : PRINT "YOU:  ";: GOSUB 1000
210 IF Q$ = "" THEN 200
220 IF Q$ = "BYE" THEN 400
230 HA$ = " " + Q$ + " ": BK = 0
240 FOR N = 1 TO NK
250 NE$ = " " + KW$(N) + " ": GOSUB 600
260 IF P > 0 THEN BK = N: TL$ = MID$ (HA$,P + LEN(NE$)): N = NK
270 NEXT N
280 IF BK = 0 THEN GC = GC+1: IF GC > NG THEN GC = 1
285 IF BK = 0 THEN AN$ = GE$(GC): GOTO 340
290 IX = RP(BK) + RC(BK): RC(BK) = RC(BK)+1: IF RC(BK) >= RN(BK) THEN RC(BK) = 0
300 AN$ = RS$(IX)
310 NE$ = "*": HA$ = AN$: GOSUB 600
320 IF P = 0 THEN 340
330 GOSUB 700: AN$ = LEFT$ (AN$,P-1) + RF$ + MID$ (AN$,P+1)
340 PRINT "PAUL: ";AN$
350 SP$ = AN$: GOSUB 950
360 GOTO 200
400 SP$ = "GOODBYE. IT WAS NICE TALKING TO YOU.": PRINT : PRINT "PAUL: ";SP$: GOSUB 950
410 END
600 P = 0: LN = LEN(NE$): LH = LEN(HA$)
610 IF LN > LH THEN RETURN
620 FOR I = 1 TO LH-LN+1
630 IF MID$ (HA$,I,LN) = NE$ THEN P = I: I = LH-LN+1
640 NEXT I
650 RETURN
700 RF$ = "": W$ = "": TL$ = TL$ + " "
710 FOR I = 1 TO LEN(TL$)
720 C$ = MID$ (TL$,I,1)
730 IF C$ <> " " THEN W$ = W$ + C$: GOTO 780
740 IF W$ = "" THEN 780
750 GOSUB 800
760 IF RF$ <> "" THEN RF$ = RF$ + " "
770 RF$ = RF$ + M$: W$ = ""
780 NEXT I
790 RETURN
800 M$ = W$
805 IF W$ = "I" THEN M$ = "YOU"
810 IF W$ = "ME" THEN M$ = "YOU"
815 IF W$ = "MY" THEN M$ = "YOUR"
820 IF W$ = "AM" THEN M$ = "ARE"
825 IF W$ = "MINE" THEN M$ = "YOURS"
830 IF W$ = "MYSELF" THEN M$ = "YOURSELF"
835 IF W$ = "YOU" THEN M$ = "I"
840 IF W$ = "YOUR" THEN M$ = "MY"
845 IF W$ = "YOURS" THEN M$ = "MINE"
850 IF W$ = "YOURSELF" THEN M$ = "MYSELF"
855 IF W$ = "WERE" THEN M$ = "WAS"
860 IF W$ = "IM" THEN M$ = "YOU ARE"
865 RETURN
950 FOR I = 1 TO LEN(SP$): POKE DR, ASC( MID$ (SP$,I,1)): NEXT I
960 POKE DR,13: RETURN
1000 Q$ = ""
1010 GET C$: A = ASC(C$)
1020 IF A = 13 THEN PRINT : RETURN
1030 IF A <> 8 THEN 1060
1040 IF LEN(Q$) > 0 THEN Q$ = LEFT$ (Q$, LEN(Q$)-1): PRINT C$;" ";C$;
1050 GOTO 1010
1060 IF A < 32 THEN 1010
1065 IF LEN(Q$) > 200 THEN 1010
1070 IF C$ = "." OR C$ = "," OR C$ = "?" OR C$ = "!" OR C$ = "'" THEN 1010
1080 IF A > 96 AND A < 123 THEN C$ = CHR$ (A-32)
1090 Q$ = Q$ + C$: PRINT C$;
1100 GOTO 1010
